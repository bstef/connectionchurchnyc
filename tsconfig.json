{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "skipLibCheck": true
  },
  "include": [
    "worker/**/*.ts",
    "worker-configuration.d.ts",
    "functions/**/*.ts"
  ]
}
